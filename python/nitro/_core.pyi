from os import PathLike
from typing import Any

__version__: str
SIMULATOR: str
SOURCE_HASH: str

class MeshLoadError(Exception): ...
class EnvError(RuntimeError): ...

class MeshReport:
    @property
    def folder(self) -> str: ...
    @property
    def soccar_files(self) -> int: ...
    @property
    def soccar_recognized(self) -> int: ...
    @property
    def soccar_expected(self) -> int: ...
    def is_complete(self) -> bool: ...

def load_collision_meshes(folder: str | PathLike[str]) -> MeshReport: ...
def custom_rewards() -> list[
    tuple[str, str, bool, str, list[tuple[str, str, bool, str]]]
]: ...  # (name, description, every step, file, [(setting, Rust type, optional, description)])
def action_controls(index: int) -> list[float]: ...
def num_actions() -> int: ...
def demonstrations(
    path: str, settings_json: str, softness: float = ..., compact: bool = ...
) -> dict[str, Any]: ...
def demonstrations_bytes(
    data: bytes, name: str, settings_json: str, softness: float = ...
) -> dict[str, Any]: ...
def replay_samples(
    cars: int,
    frames: bytes,
    usable: bytes,
    car_floats: bytes,
    car_flags: bytes,
    ball_floats: bytes,
    name: str,
    settings_json: str,
    softness: float = ...,
) -> dict[str, Any]: ...
def observation_layout(settings_json: str) -> tuple[int, int, int, int, int, int]: ...
def observation_layout_of(
    observation: str, team_size: int, opponents: bool, obs_team_size: int
) -> tuple[int, int, int, int, int, int]: ...

class ObsLayout:
    @property
    def size(self) -> int: ...
    @property
    def self_part(self) -> int: ...
    @property
    def other_car(self) -> int: ...
    @property
    def teammates(self) -> int: ...
    @property
    def opponents(self) -> int: ...
    @property
    def room(self) -> int: ...

class EpisodeRecord:
    @property
    def env(self) -> int: ...
    @property
    def setter(self) -> int: ...
    @property
    def car(self) -> int: ...
    @property
    def seconds(self) -> float: ...
    @property
    def terminal(self) -> bool: ...
    @property
    def first_touch(self) -> float: ...
    @property
    def landed(self) -> float: ...
    @property
    def boost_collected(self) -> float: ...
    @property
    def ball_y_after_touch(self) -> float: ...
    @property
    def goal(self) -> int: ...
    @property
    def ball_first_touch(self) -> float: ...
    @property
    def kickoff(self) -> int: ...

class EnvStats:
    @property
    def agent_steps(self) -> int: ...
    @property
    def raw(self) -> list[float]: ...
    @property
    def weighted(self) -> list[float]: ...
    @property
    def weighted_abs(self) -> list[float]: ...
    @property
    def own_abs(self) -> list[float]: ...
    @property
    def fired(self) -> list[int]: ...
    @property
    def env_steps(self) -> int: ...
    @property
    def step_seconds(self) -> float: ...
    @property
    def physics_seconds(self) -> float: ...
    @property
    def episodes(self) -> list[EpisodeRecord]: ...
    @property
    def play(self) -> dict[str, float]: ...
    @property
    def play_by_size(self) -> dict[int, dict[str, float]]: ...
    @property
    def card_submits(self) -> int: ...
    @property
    def card_submit_seconds(self) -> float: ...

class EnvPool:
    def __init__(self, settings_json: str) -> None: ...
    @property
    def num_groups(self) -> int: ...
    @property
    def num_workers(self) -> int: ...
    @property
    def obs_size(self) -> int: ...
    @property
    def num_actions(self) -> int: ...
    @property
    def obs_layout(self) -> ObsLayout: ...
    @property
    def arena_team_sizes(self) -> list[int]: ...
    @property
    def reward_labels(self) -> list[str]: ...
    def group_agents(self, group: int) -> int: ...
    def attach(self, group: int, tensors: Any) -> None: ...
    def observe(self, group: int) -> None: ...
    def step(self, group: int) -> None: ...
    def wait(self, group: int) -> None: ...
    def card_start(self, group: int) -> tuple[int, int]: ...
    def take_stats(self) -> EnvStats: ...
    def set_counted(self, arena: int, counted: list[bool]) -> None: ...
    def frame(self, arena: int) -> list[float]: ...
    def start_capture(self, arena: int, every_ticks: int) -> list[list[float]]: ...
    def take_capture(self, arena: int) -> list[float]: ...

class Policy:
    def __init__(self, path: str | PathLike[str]) -> None: ...
    @property
    def obs_size(self) -> int: ...
    @property
    def num_actions(self) -> int: ...
    def header(self) -> dict[str, Any]: ...
    def logits(self, obs: list[float]) -> list[float]: ...
    def logits_batch(self, obs: list[float], rows: int) -> list[float]: ...
    @property
    def reads_any_cars(self) -> bool: ...
    def logits_cars(self, obs: list[float], teammates: int, opponents: int) -> list[float]: ...
    @staticmethod
    def argmax(logits: list[float], mask: list[int]) -> int: ...

class BenchmarkResult:
    @property
    def agents(self) -> int: ...
    @property
    def steps(self) -> int: ...
    @property
    def seconds(self) -> float: ...
    @property
    def stats(self) -> EnvStats: ...

def rust_driven_benchmark(
    settings_json: str, actions: bytes, warmup_steps: int, steps: int, pipelined: bool
) -> BenchmarkResult: ...
